					"// Pre-request script to set up test data",
					"if (pm.environment.get('sample_base64_image') === undefined) {",
					"    // Set a placeholder for base64 image data",
					"    pm.environment.set('sample_base64_image', 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==');",
					"}"
